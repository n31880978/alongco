# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase browser-safe key. This is safe to expose because RLS is
# enforced in the database; it is not the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name supported during migration. Set one public key, not both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never import into a client component (CLAUDE.md §7).
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler, not the direct connection — serverless exhausts direct ones.
DATABASE_URL=

# Razorpay Payment Gateway. Test keys work without entity verification;
# mode is derived from the key prefix (rzp_test_ / rzp_live_), never a separate var.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Platform -----------------------------------------------------------------
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_HOST=admin.alongco.com

# Server-only salt for irreversible OTP/IP abuse-prevention hashes. Generate
# with `openssl rand -hex 32`; never expose this as NEXT_PUBLIC_*.
OTP_HASH_SALT=

# Dedicated hosted Supabase *test* project only. The DB test suite truncates
# mutable application tables, so never use a production connection string.
TEST_DATABASE_URL=

# --- Auth ---------------------------------------------------------------------
# Supabase Auth phone provider delivers the OTP over this channel.
#   sms       MSG91, via the Send-SMS auth hook (supabase/functions/send-sms-otp)
#   whatsapp  needs a Twilio account with an approved WhatsApp sender

# MSG91 — set as SUPABASE FUNCTION SECRETS, not here. Listed for reference only:
#   supabase secrets set MSG91_AUTH_KEY=… MSG91_TEMPLATE_ID=… MSG91_SENDER_ID=… \
#                        SEND_SMS_HOOK_SECRET=v1,whsec_…
# Indian SMS needs DLT registration of the entity, the sender header and the
# template before anything is actually delivered.

# --- Public contact details (shown in the UI) ---------------------------------
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

# --- Local testing ------------------------------------------------------------
# Used by npm run db:reset / db:test against a local Postgres.
ALONGCO_TEST_DB=alongco_test

# --- Analytics (T23) ----------------------------------------------------------
# Google Analytics measurement id. Leave empty and no third-party script loads
# at all. Only the six PRD §10 funnel events are sent, never anything identifying.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
